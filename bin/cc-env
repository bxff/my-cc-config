#!/usr/bin/env node
// cc-env — emit launcher env from config.json: routing payload (CC_PROVIDERS),
// the Agent-tool model list (CC_EXTRA_MODELS), the /model picker entry
// (ANTHROPIC_CUSTOM_MODEL_OPTION*), and the picker extras (CC_PICKER_MODELS).
// Source with: eval "$(node cc-env)"
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const dir = path.dirname(fileURLToPath(import.meta.url));
// config lives next to cc-env in the runtime dir, or ../config.json in the repo
const cfgPath = fs.existsSync(path.join(dir, 'config.json'))
  ? path.join(dir, 'config.json')
  : path.join(dir, '..', 'config.json');
const cfg = JSON.parse(fs.readFileSync(cfgPath, 'utf8'));
const providers = (cfg.providers || []).map((p) => ({
  prefix: p.prefix, baseUrl: p.baseUrl, apiKeyEnv: p.apiKeyEnv,
}));
const models = (cfg.providers || []).flatMap((p) => (p.models || []).map((m) => (typeof m === 'string' ? m : m.name)));
const allModels = (cfg.providers || []).flatMap((p) => (p.models || []).map((m) => (typeof m === 'string' ? { name: m, label: m, description: '' } : m)));

const primary = allModels[0];
const pickerModels = allModels.map((m) => ({ value: m.name, label: m.label || m.name, description: m.description || '' }));

const esc = (s) => "'" + String(s).replace(/'/g, "'\\''") + "'";
console.log('export CC_PROVIDERS=' + esc(JSON.stringify(providers)));
console.log('export CC_EXTRA_MODELS=' + esc(models.join(',')));
if (primary) {
  console.log('export ANTHROPIC_CUSTOM_MODEL_OPTION=' + esc(primary.name));
  console.log('export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME=' + esc(primary.label || primary.name));
  console.log('export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION=' + esc(primary.description || ''));
}
console.log('export CC_PICKER_MODELS=' + esc(JSON.stringify(pickerModels)));
console.log('export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1');
console.log('export CLAUDE_CODE_AUTO_COMPACT_WINDOW=' + esc(String(cfg.autoCompactWindow ?? 500000)));
console.log('export CLAUDE_CODE_MAX_OUTPUT_TOKENS=' + esc(String(cfg.maxOutputTokens ?? 128000)));
console.log('export CLAUDE_CODE_EFFORT_LEVEL=' + esc(cfg.effortLevel ?? 'max'));
console.log('export CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1');
